{
  "schemaVersion": 2,
  "id": "t2-22",
  "track": "T2",
  "order": 22,
  "runtime": "js",
  "title": "종합 문제 2: 조건에 따라 배송비 반환하기",
  "steps": [
    {
      "kind": "read",
      "title": "연체 일수로 연체료를 정하는 과정 읽기",
      "brief": [
        "조건에 따라 다른 값을 반환하는 함수는 먼저 업무 기준을 경계값으로 바꿔야 합니다. 구매 금액이 100000 이상일 때 1을 반환하고, 그 조건을 만족하지 않으면 0을 반환합니다. 첫 return이 실행되면 함수가 끝나므로 else 없이도 두 경로를 만들 수 있습니다. 100000처럼 경계에 정확히 걸린 입력이 어느 쪽인지도 >= 기호로 확인해야 합니다.",
        {
          "code": [
            "getLateFee(8); // 5000",
            "getLateFee(2); // 0"
          ]
        },
        "문제를 풀 때는 입력과 종료 조건 확인 → 조건 또는 반복 흐름 작성 → 계산 결과 반환 → 경계값으로 결과 확인 순으로 진행하세요."
      ]
    },
    {
      "kind": "run",
      "title": "구매 금액으로 사은품 수량 정하기",
      "brief": [
        "구매 금액이 100000원 이상이면 1, 아니면 0을 반환하세요."
      ],
      "code": "function getGiftCount(purchaseAmount) {\n  if (purchaseAmount >= 100000) return 1;\n  return 0;\n}\nconsole.log(getGiftCount(120000));\nconsole.log(getGiftCount(70000));\n"
    },
    {
      "kind": "tweak",
      "title": "무료 배송 경계값을 포함하도록 비교 연산자 고치기",
      "brief": [
        "금액이 정확히 50000일 때도 무료여야 합니다. >를 >=로 바꿔 경계값을 포함하세요."
      ],
      "code": "function shippingFee(amount) {\n  if (amount > 50000) return 0;\n  return 3000;\n}\nconsole.log(shippingFee(50000));\n"
    },
    {
      "kind": "write",
      "title": "배송비 반환하기",
      "brief": [
        "getShippingFee(orderAmount)를 작성하세요.",
        "50000원 이상이면 0, 아니면 3000을 반환하세요."
      ],
      "code": "// getShippingFee 함수를 작성하세요.\n",
      "entry": "getShippingFee",
      "solutionCode": "function getShippingFee(orderAmount) {\n  if (orderAmount >= 50000) return 0;\n  return 3000;\n}\n",
      "asserts": [
        {
          "type": "value",
          "label": "무료 배송",
          "args": [
            60000
          ],
          "expected": 0
        },
        {
          "type": "value",
          "label": "경계값",
          "args": [
            50000
          ],
          "expected": 0
        },
        {
          "type": "value",
          "label": "일반 배송",
          "args": [
            30000
          ],
          "expected": 3000
        }
      ],
      "hints": [
        "orderAmount >= 50000을 if 조건으로 사용하세요.",
        "조건 밖에서는 3000을 반환하세요."
      ]
    },
    {
      "kind": "write",
      "title": "회원 여부에 따라 적립률 반환하기",
      "brief": [
        "getPointRate(isMember)를 작성해 회원이면 0.05, 아니면 0.01을 반환하세요."
      ],
      "code": "// getPointRate 함수를 작성하세요.\n",
      "entry": "getPointRate",
      "solutionCode": "function getPointRate(isMember) {\n  if (isMember) return 0.05;\n  return 0.01;\n}\n",
      "asserts": [
        {
          "type": "value",
          "label": "회원",
          "args": [
            true
          ],
          "expected": 0.05
        },
        {
          "type": "value",
          "label": "비회원",
          "args": [
            false
          ],
          "expected": 0.01
        }
      ],
      "hints": [
        "if (isMember)로 회원을 확인하세요.",
        "회원 분기에서 0.05를 반환하고 나머지는 0.01을 반환하세요."
      ]
    },
    {
      "kind": "write",
      "title": "무게 기준 추가 요금 반환하기",
      "brief": [
        "getWeightFee(weight)를 작성해 10kg 초과면 5000, 아니면 0을 반환하세요. 10kg은 추가 요금이 없습니다."
      ],
      "code": "// getWeightFee 함수를 작성하세요.\n",
      "entry": "getWeightFee",
      "solutionCode": "function getWeightFee(weight) {\n  if (weight > 10) return 5000;\n  return 0;\n}\n",
      "asserts": [
        {
          "type": "value",
          "label": "초과",
          "args": [
            11
          ],
          "expected": 5000
        },
        {
          "type": "value",
          "label": "경계",
          "args": [
            10
          ],
          "expected": 0
        }
      ],
      "hints": [
        "초과 조건은 weight > 10입니다.",
        "조건을 만족하지 않으면 0을 반환하세요."
      ]
    }
  ],
  "learningGoal": "조건을 먼저 판단하고 각 경우에 맞는 값을 return으로 반환한다."
}
