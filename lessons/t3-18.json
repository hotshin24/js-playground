  "title": "작은 복습 3: 여러 프로퍼티로 문장 만들기",
  "steps": [
    {
      "kind": "read",
      "title": "지점 객체로 안내 문장 만드는 과정 읽기",
      "brief": [
        "여러 프로퍼티를 조합할 때는 먼저 최종 문장의 구조를 정하고 각 자리에 맞는 값을 꺼냅니다. delivery.recipient는 사람 이름, delivery.city는 지역이므로 템플릿 리터럴에서 순서를 바꾸면 문장의 의미도 달라집니다. 프로퍼티 접근 결과도 일반 값이므로 문자열 안에 넣거나 비교와 계산에 사용할 수 있습니다."
      ]
    },
    {
      "kind": "run",
      "title": "배송 객체로 요약 문장 만들기",
      "brief": [
        "recipient와 city를 읽어 배송 문장을 만드세요."
      ],
      "code": "const delivery = { recipient: '민호', city: '부산' };\nconsole.log(`${delivery.recipient} · ${delivery.city} 배송`);\n"
    },
    {
      "kind": "write",
      "title": "사용자 요약 반환하기",
      "brief": [
        "makeUserSummary(user)를 작성하세요.",
        "정해진 형식으로 이름과 역할을 조합하세요."
      ],
      "code": "// makeUserSummary 함수를 작성하세요.\n",
      "entry": "makeUserSummary",
      "solutionCode": "function makeUserSummary(user) {\n  return `${user.name} · ${user.role} 담당`;\n}\n",
      "asserts": [
        {
          "type": "value",
          "label": "검수 담당자",
          "args": [
            {
              "name": "민지",
              "role": "검수"
            }
          ],
          "expected": "민지 · 검수 담당"
        },
        {
          "type": "value",
          "label": "배송 담당자",
          "args": [
            {
              "name": "준호",
              "role": "배송"
            }
          ],
          "expected": "준호 · 배송 담당"
        }
      ],
      "hints": [
        "user.name과 user.role을 읽으세요.",
        "가운데에 ' · ', 끝에 ' 담당'을 붙이세요."
      ]
    }
  ]
